# Multi-stage build for lightweight standalone daemon
FROM rust:1.75-slim AS builder

WORKDIR /usr/src/hilbert-ledger
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY config ./config

RUN cargo build --release

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /usr/src/hilbert-ledger/target/release/qcos-hilbert-ledger /app/qcos-hilbert-ledger
COPY --from=builder /usr/src/hilbert-ledger/config /app/config

# Create socket runtime directory
RUN mkdir -p /tmp

ENTRYPOINT ["/app/qcos-hilbert-ledger"]